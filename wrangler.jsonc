{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "domainhr",
	"main": "./src/index.ts",
	"compatibility_date": "2026-09-07",
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		"not_found_handling": "single-page-application",
		"run_worker_first": ["/agents/*", "/api/*"],
	},
	"durable_objects": {
		"bindings": [
			{
				"name": "DomainVoiceAgent",
				"class_name": "DomainVoiceAgent",
			},
		],
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["DomainVoiceAgent"],
		},
	],
	"vars": {
		"MISTRAL_MODEL": "mistral-large-4",
		"MISTRAL_TTS_MODEL": "voxtral-mini-tts-3",
	},
	"observability": {
		"enabled": true,
	},
	"upload_source_maps": true,
}
